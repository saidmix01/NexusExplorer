<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates every app icon / MSIX visual asset from a single vector drawing.
    Not part of the app solution. Run from the repo root: dotnet run (project tools/IconGen)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

</Project>
