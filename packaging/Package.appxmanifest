<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for Nexus File Manager.

  The $TOKENS$ are filled in by packaging/build-msix.ps1:
    $IDENTITY_NAME$   Package/Identity/Name            (Partner Center > Product identity)
    $PUBLISHER$       Package/Identity/Publisher       (Partner Center > Product identity, "CN=...")
    $PUBLISHER_NAME$  Package/Properties/PublisherDisplayName
    $VERSION$         Four-part version, last part must be 0 for the Store (e.g. 1.0.0.0)
    $ARCH$            x64 or arm64
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>Nexus File Manager</DisplayName>
    <PublisherDisplayName>$PUBLISHER_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A modern, tabbed file manager with an integrated terminal, live preview and project tools.</Description>
  </Properties>

  <!-- 17763 (1809) is the minimum: the embedded terminal uses ConPTY. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Store listing languages. The first one is the default listing language.
       Note: the app UI itself is English only. -->
  <Resources>
    <Resource Language="es-co" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="NexusExplorer"
      Executable="NexusExplorer.App.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Nexus File Manager"
        Description="A modern, tabbed file explorer with an integrated terminal and live preview."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="Nexus"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png"
          Square310x310Logo="Assets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0D1526" />
      </uap:VisualElements>

      <Extensions>
        <!-- Lets users and tools (e.g. VS Code "Reveal in file explorer") launch the app by
             name, since the WindowsApps install path changes on every update. -->
        <uap3:Extension
          Category="windows.appExecutionAlias"
          Executable="NexusExplorer.App.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="nexusexplorer.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for any packaged Win32 desktop app. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
