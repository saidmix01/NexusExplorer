<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexusExplorer.App.ViewModels"
        x:Class="NexusExplorer.App.Views.PropertiesWindow"
        x:DataType="vm:PropertiesViewModel"
        Title="{Binding Title}"
        Width="420" Height="520"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource NexusDialogBackground}">

    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="0" Padding="24,20">
            <StackPanel Spacing="16">

                <!-- Header: Icon + Name -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                    <TextBlock Text="{Binding IsDirectory, Converter={x:Static vm:PropertiesIconConverter.Instance}}"
                               FontSize="28" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"
                               Foreground="{DynamicResource NexusText}" />
                </StackPanel>

                <Separator Background="{DynamicResource NexusBorderLight}" Height="1" />

                <!-- Error state -->
                <Border IsVisible="{Binding HasError}" Background="#FFF0F0" CornerRadius="6" Padding="12" BorderBrush="#FFCCCC" BorderThickness="1">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource NexusDangerBackground}" TextWrapping="Wrap" FontSize="12" />
                </Border>

                <!-- General Section -->
                <TextBlock Text="General" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource NexusTextPrimary}" />

                <!-- Type -->
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Type" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TypeDescription}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource NexusText}" />
                </Grid>

                <!-- Location -->
                <Grid ColumnDefinitions="110,*" IsVisible="{Binding IsSingleItem}">
                    <TextBlock Grid.Column="0" Text="Location" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource NexusText}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                </Grid>

                <!-- Size -->
                <Grid ColumnDefinitions="110,*">
                    <TextBlock Grid.Column="0" Text="Size" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NexusText}" />
                        <ProgressBar IsVisible="{Binding IsCalculatingSize}" IsIndeterminate="True"
                                     Width="60" Height="3" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Contains (folders / multi) -->
                <Grid ColumnDefinitions="110,*" IsVisible="{Binding ContainsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Grid.Column="0" Text="Contains" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ContainsText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource NexusText}" />
                </Grid>

                <Separator Background="{DynamicResource NexusBorderLight}" Height="1" IsVisible="{Binding IsSingleItem}" />

                <!-- Dates Section (single item only) -->
                <StackPanel Spacing="8" IsVisible="{Binding IsSingleItem}">
                    <TextBlock Text="Dates" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource NexusTextPrimary}" />

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Grid.Column="0" Text="Created" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CreatedText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NexusText}" />
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Grid.Column="0" Text="Modified" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NexusText}" />
                    </Grid>

                    <Grid ColumnDefinitions="110,*">
                        <TextBlock Grid.Column="0" Text="Last accessed" Foreground="{DynamicResource NexusTextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AccessedText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NexusText}" />
                    </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource NexusBorderLight}" Height="1" />

                <!-- Attributes Section -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Attributes" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource NexusTextPrimary}" />

                    <CheckBox Content="Read-only" IsChecked="{Binding IsReadOnly}" FontSize="12" />
                    <CheckBox Content="Hidden" IsChecked="{Binding IsHidden}" FontSize="12" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource NexusBorderLight}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: utility buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy Path" Command="{Binding CopyPathCommand}"
                            IsVisible="{Binding IsSingleItem}"
                            Padding="12,6" FontSize="12" />
                    <Button Content="Open Location" Command="{Binding OpenLocationCommand}"
                            IsVisible="{Binding IsSingleItem}"
                            Padding="12,6" FontSize="12" />
                </StackPanel>
                <!-- Right: Apply / Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Apply" Command="{Binding ApplyAttributesCommand}"
                            IsVisible="{Binding AttributesChanged}"
                            Padding="16,6" FontSize="12" />
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Padding="16,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
