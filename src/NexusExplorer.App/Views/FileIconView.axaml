<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusExplorer.App.ViewModels"
             xmlns:models="using:NexusExplorer.Core.Models"
             xmlns:controls="using:NexusExplorer.App.Controls"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             x:Class="NexusExplorer.App.Views.FileIconView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- ListBoxItem: remove default selection chrome, use custom -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <!-- Selection in icon view uses only a stronger fill (no border). A border on the
             ContentPresenter would enlarge the ListBoxItem by 2px around its fixed-width child
             and reflow the WrapPanel, making the tile appear to resize on selection. Background
             alone does not affect layout, so the tile size stays constant. -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusIconSelection}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusIconSelectionHover}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusIconSelectionHover}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Styles>

    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
             SelectionMode="Multiple" Background="Transparent" BorderThickness="0"
             DoubleTapped="FileList_DoubleTapped" SelectionChanged="FileList_SelectionChanged"
             Name="FileListBox"
             AutomationProperties.Name="File list - icon view"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">

        <!-- WrapPanel for icon grid layout. For large directories (1000+ items),
             performance is managed via async thumbnail loading with cancellation
             and deferred icon rendering in FileIconControl. -->
        <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" Margin="10,8" />
            </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:FileSystemItem">
                <Panel>
                    <!-- Group Header (full width, forces new line in WrapPanel) -->
                    <Border IsVisible="{Binding IsGroupHeader}"
                            Margin="0,14,0,6" BorderBrush="{DynamicResource NexusGroupHeaderBorder}"
                            BorderThickness="0,0,0,1" Padding="4,0,0,6"
                            MinWidth="10000">
                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{DynamicResource NexusGroupHeaderText}" />
                    </Border>

                    <!-- File/Folder Item -->
                    <Border IsVisible="{Binding !IsGroupHeader}"
                            Width="{Binding $parent[UserControl].DataContext.ComputedItemWidth}"
                            Padding="4,8,4,6"
                            Background="Transparent"
                            ToolTip.Tip="{Binding Name}"
                            PointerPressed="Item_PointerPressed">
                        <Border.ContextMenu>
                            <ContextMenu x:CompileBindings="False">
                                <!-- Recycle Bin: restore -->
                                <MenuItem Header="Restore" Command="{Binding $parent[UserControl].DataContext.RestoreSelectedCommand}"
                                          IsVisible="{Binding $parent[UserControl].DataContext.IsRecycleBinView}"><MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowUndo" /></MenuItem.Icon></MenuItem>
                                <Separator IsVisible="{Binding $parent[UserControl].DataContext.IsRecycleBinView}" />
                            
                                <!-- ===== 1. OPEN ===== -->
                                <MenuItem Header="Open" Command="{Binding $parent[UserControl].DataContext.OpenItemCommand}" CommandParameter="{Binding}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Open" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Open With..." Command="{Binding $parent[UserControl].DataContext.OpenWithCommand}" CommandParameter="{Binding}"
                                          IsVisible="{Binding Type, Converter={x:Static vm:IsFileConverter.Instance}}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Apps" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Open in New Tab" Command="{Binding $parent[UserControl].DataContext.OpenInNewTabCommand}" CommandParameter="{Binding}"
                                          IsVisible="{Binding Type, Converter={x:Static vm:IsNavigableConverter.Instance}}"><MenuItem.Icon><fluent:SymbolIcon Symbol="TabAdd" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Open with editor" IsVisible="{Binding Type, Converter={x:Static vm:IsDirectoryConverter.Instance}}"
                                          ItemsSource="{Binding $parent[UserControl].DataContext.InstalledEditors}"
                                          Tag="{Binding $parent[UserControl].DataContext}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Edit" /></MenuItem.Icon>
                                    <MenuItem.Styles>
                                        <Style Selector="MenuItem > MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.OpenWithEditorCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="Icon">
                                                <Template>
                                                    <controls:EditorIconControl ExecutablePath="{Binding ExecutablePath}" Width="16" Height="16" />
                                                </Template>
                                            </Setter>
                                        </Style>
                                    </MenuItem.Styles>
                                </MenuItem>
                                <!-- Terminal submenu: direct launch + other profiles -->
                                <MenuItem Header="Terminal" IsVisible="{Binding Type, Converter={x:Static vm:IsNavigableConverter.Instance}}"
                                          Tag="{Binding $parent[UserControl].DataContext}"><MenuItem.Icon><fluent:SymbolIcon Symbol="WindowConsole" /></MenuItem.Icon>
                                    <MenuItem Header="Open in Terminal" Command="{Binding $parent[UserControl].DataContext.OpenInTerminalCommand}" CommandParameter="{Binding}"><MenuItem.Icon><fluent:SymbolIcon Symbol="WindowConsole" /></MenuItem.Icon></MenuItem>
                                    <Separator />
                                    <MenuItem Header="Open in Other Terminal" Classes="otherTerminal" ItemsSource="{Binding $parent[UserControl].DataContext.AvailableTerminalProfiles}" Tag="{Binding $parent[UserControl].DataContext}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Code" /></MenuItem.Icon>
                                        <MenuItem.Styles>
                                            <Style Selector="MenuItem.otherTerminal > MenuItem">
                                                <Setter Property="Header" Value="{Binding Name}" />
                                                <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.OpenInOtherTerminalCommand}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="Icon">
                                                    <Template>
                                                        <fluent:SymbolIcon Symbol="{Binding IconKey, Converter={x:Static vm:TerminalIconConverter.Instance}}" FontSize="14" />
                                                    </Template>
                                                </Setter>
                                            </Style>
                                        </MenuItem.Styles>
                                    </MenuItem>
                                </MenuItem>
                                <!-- Project run/build commands (visible only when the folder is a detected project) -->
                                <MenuItem Header="Project" ItemsSource="{Binding $parent[UserControl].DataContext.ContextMenuProjectCommands}"
                                          Tag="{Binding $parent[UserControl].DataContext}"
                                          IsVisible="{Binding $parent[UserControl].DataContext.HasContextMenuProjectCommands}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Box" /></MenuItem.Icon>
                                    <MenuItem.Styles>
                                        <Style Selector="MenuItem > MenuItem">
                                            <Setter Property="Header" Value="{Binding DisplayCommand}" />
                                            <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.RunProjectCommandInTerminalCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="Icon">
                                                <Template>
                                                    <fluent:SymbolIcon Symbol="{Binding Converter={x:Static vm:ProjectCommandIconConverter.Instance}}" FontSize="14" />
                                                </Template>
                                            </Setter>
                                        </Style>
                                    </MenuItem.Styles>
                                </MenuItem>
                                <Separator />
                            
                                <!-- ===== 2. EDIT / CLIPBOARD ===== -->
                                <MenuItem Header="Cut" Command="{Binding $parent[UserControl].DataContext.CutSelectedCommand}" InputGesture="Ctrl+X"><MenuItem.Icon><fluent:SymbolIcon Symbol="Cut" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Copy" Command="{Binding $parent[UserControl].DataContext.CopySelectedCommand}" InputGesture="Ctrl+C"><MenuItem.Icon><fluent:SymbolIcon Symbol="Copy" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Copy Path" Command="{Binding $parent[UserControl].DataContext.CopyPathCommand}" InputGesture="Ctrl+Shift+C"><MenuItem.Icon><fluent:SymbolIcon Symbol="Link" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Paste" Command="{Binding $parent[UserControl].DataContext.PasteCommand}" InputGesture="Ctrl+V" IsEnabled="{Binding $parent[UserControl].DataContext.HasClipboardContent}"><MenuItem.Icon><fluent:SymbolIcon Symbol="ClipboardPaste" /></MenuItem.Icon></MenuItem>
                                <Separator />
                            
                                <!-- ===== 3. FILE MANAGEMENT ===== -->
                                <MenuItem Header="Rename" Command="{Binding $parent[UserControl].DataContext.StartRenameCommand}" InputGesture="F2"><MenuItem.Icon><fluent:SymbolIcon Symbol="Rename" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Duplicate" Command="{Binding $parent[UserControl].DataContext.DuplicateSelectedCommand}" InputGesture="Ctrl+D"><MenuItem.Icon><fluent:SymbolIcon Symbol="DocumentCopy" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Delete" Command="{Binding $parent[UserControl].DataContext.DeleteSelectedCommand}" InputGesture="Delete"><MenuItem.Icon><fluent:SymbolIcon Symbol="Delete" /></MenuItem.Icon></MenuItem>
                                <Separator />
                            
                                <!-- ===== 4. TOOLS ===== -->
                                <!-- Compress / Archive submenu -->
                                <MenuItem Header="Compress / Archive"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderZip" /></MenuItem.Icon>
                                    <MenuItem Header="Compress" Command="{Binding $parent[UserControl].DataContext.CompressSelectedCommand}"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderZip" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Extract Here" Command="{Binding $parent[UserControl].DataContext.ExtractSelectedCommand}"
                                              IsVisible="{Binding Path, Converter={x:Static vm:IsZipFileConverter.Instance}}"><MenuItem.Icon><fluent:SymbolIcon Symbol="ArchiveArrowBack" /></MenuItem.Icon></MenuItem>
                                    <Separator IsVisible="{Binding $parent[UserControl].DataContext.IsWinRarAvailable}" />
                                    <MenuItem Header="Open with WinRAR" Command="{Binding $parent[UserControl].DataContext.OpenWithWinRarCommand}"
                                              IsVisible="{Binding $parent[UserControl].DataContext.IsWinRarAvailable}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Archive" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Extract here (WinRAR)" Command="{Binding $parent[UserControl].DataContext.ExtractHereWithWinRarCommand}"
                                              IsVisible="{Binding Path, Converter={x:Static vm:IsZipFileConverter.Instance}}"><MenuItem.Icon><fluent:SymbolIcon Symbol="ArchiveArrowBack" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Extract to folder (WinRAR)" Command="{Binding $parent[UserControl].DataContext.ExtractToFolderWithWinRarCommand}"
                                              IsVisible="{Binding Path, Converter={x:Static vm:IsZipFileConverter.Instance}}"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderOpen" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Add to archive (WinRAR)" Command="{Binding $parent[UserControl].DataContext.AddToArchiveWithWinRarCommand}"
                                              IsVisible="{Binding $parent[UserControl].DataContext.IsWinRarAvailable}"><MenuItem.Icon><fluent:SymbolIcon Symbol="BoxMultiple" /></MenuItem.Icon></MenuItem>
                                </MenuItem>
                                <!-- Move / Copy submenu -->
                                <MenuItem Header="Move / Copy"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderArrowRight" /></MenuItem.Icon>
                                    <MenuItem Header="Move To..." Command="{Binding $parent[UserControl].DataContext.ShowMoveToCommand}"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderArrowRight" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Copy To..." Command="{Binding $parent[UserControl].DataContext.ShowCopyToCommand}"><MenuItem.Icon><fluent:SymbolIcon Symbol="CopyArrowRight" /></MenuItem.Icon></MenuItem>
                                </MenuItem>
                                <Separator />
                            
                                <!-- ===== 5. ENVIRONMENT & PROPERTIES ===== -->
                                <!-- Folder Color submenu (includes Default to clear) -->
                                <MenuItem Header="Folder Color" IsVisible="{Binding Type, Converter={x:Static vm:IsDirectoryConverter.Instance}}"
                                          ItemsSource="{Binding $parent[UserControl].DataContext.FolderColorMenuOptions}"
                                          Tag="{Binding $parent[UserControl].DataContext}"><MenuItem.Icon><fluent:SymbolIcon Symbol="ColorFill" /></MenuItem.Icon>
                                    <MenuItem.Styles>
                                        <Style Selector="MenuItem > MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.SetFolderColorCommand}" />
                                            <Setter Property="CommandParameter" Value="{Binding ColorHex}" />
                                            <Setter Property="Icon">
                                                <Template>
                                                    <Ellipse Width="12" Height="12"
                                                             Stroke="{DynamicResource NexusBorder}" StrokeThickness="1"
                                                             Fill="{Binding ColorHex, Converter={x:Static vm:ColorHexToBrushConverter.Instance}}" />
                                                </Template>
                                            </Setter>
                                        </Style>
                                    </MenuItem.Styles>
                                </MenuItem>
                                <!-- Add / Pin submenu -->
                                <MenuItem Header="Add / Pin" IsVisible="{Binding Type, Converter={x:Static vm:IsDirectoryConverter.Instance}}"
                                          Tag="{Binding $parent[UserControl].DataContext}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Pin" /></MenuItem.Icon>
                                    <MenuItem Header="Pin to Quick Access" Command="{Binding $parent[UserControl].DataContext.PinToFavoritesCommand}" CommandParameter="{Binding Path}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Pin" /></MenuItem.Icon></MenuItem>
                                    <MenuItem Header="Add to Sidebar Group"
                                              ItemsSource="{Binding $parent[UserControl].DataContext.CustomGroups}"><MenuItem.Icon><fluent:SymbolIcon Symbol="GroupList" /></MenuItem.Icon>
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <MenuItem Header="{Binding Name}" Click="AddToGroupItem_Click" />
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="Show in Explorer" Command="{Binding $parent[UserControl].DataContext.ShowInExplorerCommand}" CommandParameter="{Binding}"><MenuItem.Icon><fluent:SymbolIcon Symbol="FolderLink" /></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Properties" Command="{Binding $parent[UserControl].DataContext.ShowPropertiesCommand}" CommandParameter="{Binding}"><MenuItem.Icon><fluent:SymbolIcon Symbol="Info" /></MenuItem.Icon></MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <!-- Icon/Thumbnail inside a soft rounded "card" (Frame 2 look) -->
                            <Border CornerRadius="16"
                                    Background="{Binding Converter={x:Static vm:IconCardBackgroundConverter.Instance}}"
                                    Padding="12"
                                    HorizontalAlignment="Center">
                                <controls:FileIconControl Item="{Binding}"
                                           IconSize="{Binding $parent[UserControl].DataContext.ComputedIconSize}"
                                           UseThumbnails="{Binding $parent[UserControl].DataContext.ViewMode, Converter={x:Static vm:ViewModeToUseThumbnailsConverter.Instance}}"
                                           FlatStyle="True"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Name (read mode) -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{Binding $parent[UserControl].DataContext.ComputedFontSize}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource NexusFileItemText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static vm:InlineRenameTextVisibilityConverter.Instance}">
                                        <Binding />
                                        <Binding Path="$parent[UserControl].DataContext.SelectedItem" />
                                        <Binding Path="$parent[UserControl].DataContext.IsRenaming" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>

                            <!-- Secondary info (size / type) — visible when ShowItemInfo is ON -->
                            <TextBlock Text="{Binding Converter={x:Static vm:ItemInfoConverter.Instance}}"
                                       IsVisible="{Binding DataContext.ShowItemInfo, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       FontSize="10"
                                       Foreground="{DynamicResource NexusFileItemInfoText}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Drive usage bar (only for Drive items) -->
                            <StackPanel IsVisible="{Binding Type, Converter={x:Static vm:IsDriveTypeConverter.Instance}}"
                                        Spacing="2" HorizontalAlignment="Stretch" Margin="2,2,2,0">
                                <ProgressBar Value="{Binding UsagePercent}" Minimum="0" Maximum="100"
                                             Height="4"
                                             Foreground="{DynamicResource NexusDriveUsageForeground}"
                                             Background="{DynamicResource NexusDriveUsageBackground}" />
                                <TextBlock Text="{Binding Converter={x:Static vm:DriveSpaceInfoConverter.Instance}}"
                                           FontSize="9" Foreground="{DynamicResource NexusDriveUsageText}"
                                           TextAlignment="Center" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Name (rename mode) -->
                            <TextBox Text="{Binding $parent[UserControl].DataContext.RenameText}"
                                     Classes="inlineRename"
                                     VerticalAlignment="Top"
                                     FontSize="{Binding $parent[UserControl].DataContext.ComputedFontSize}"
                                     TextWrapping="Wrap"
                                     HorizontalAlignment="Stretch"
                                     KeyDown="RenameTextBox_KeyDown" LostFocus="RenameTextBox_LostFocus"
                                     AttachedToVisualTree="RenameTextBox_AttachedToVisualTree">
                                <TextBox.IsVisible>
                                    <MultiBinding Converter="{x:Static vm:InlineRenameVisibilityConverter.Instance}">
                                        <Binding />
                                        <Binding Path="$parent[UserControl].DataContext.SelectedItem" />
                                        <Binding Path="$parent[UserControl].DataContext.IsRenaming" />
                                    </MultiBinding>
                                </TextBox.IsVisible>
                            </TextBox>
                        </StackPanel>
                    </Border>
                </Panel>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
