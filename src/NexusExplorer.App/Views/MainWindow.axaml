<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexusExplorer.App.ViewModels"
        xmlns:models="using:NexusExplorer.Core.Models"
        xmlns:views="using:NexusExplorer.App.Views"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
        xmlns:behaviors="using:NexusExplorer.App.Behaviors"
        xmlns:controls="using:NexusExplorer.App.Controls"
        x:Class="NexusExplorer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Nexus Explorer"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="38"
        Background="Transparent"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur"
        Icon="/Assets/icon.png">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- ============================================================ -->
    <!-- STYLES: Modern Dashboard — Pill tabs, Glassmorphism,          -->
    <!-- Neumorphic depth, Electric Cyan accents                       -->
    <!-- ============================================================ -->
    <Window.Styles>
        <!-- ======== BASE UTILITY BUTTON (flat, minimal) ======== -->
        <Style Selector="Button.macBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NexusMacBtnForeground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.macBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusMacBtnHover}" />
        </Style>
        <Style Selector="Button.macBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusMacBtnPressed}" />
        </Style>
        <Style Selector="Button.macBtn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.macBtn fluent|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusMacBtnForeground}" />
        </Style>

        <!-- ======== NAVIGATION PILL BUTTONS (rounded, modern) ======== -->
        <Style Selector="Button.navBtn > fluent|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
        </Style>
        <Style Selector="Button.navBtn fluent|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
        </Style>
        <Style Selector="Button.navBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>
        <Style Selector="Button.navBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSelection}" />
        </Style>
        <Style Selector="Button.navBtn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.navBtn fluent|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
        </Style>

        <!-- ======== SEGMENTED VIEW BUTTONS (unified pill group) ======== -->
        <Style Selector="Button.segBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource NexusSegBtnBorder}" />
            <Setter Property="BorderThickness" Value="1,1,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource NexusSegBtnForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.segBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSegBtnHover}" />
        </Style>
        <Style Selector="Button.segBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSegBtnPressed}" />
        </Style>
        <Style Selector="Button.segBtn fluent|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusSegBtnForeground}" />
        </Style>
        <Style Selector="Button.segBtnFirst">
            <Setter Property="CornerRadius" Value="10,0,0,10" />
        </Style>
        <Style Selector="Button.segBtnLast">
            <Setter Property="CornerRadius" Value="0,10,10,0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ======== COMPACT FLYOUT PRESENTER (icon-only popups) ======== -->
        <Style Selector="FlyoutPresenter.compactFlyout">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxWidth" Value="200" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource NexusDialogBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NexusBorderLight}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ======== UNIFORM TOOLBAR ICON BUTTON (right cluster) ======== -->
        <Style Selector="Button.toolIcon">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toolIcon fluent|SymbolIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
        </Style>
        <Style Selector="Button.toolIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>
        <Style Selector="Button.toolIcon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSelection}" />
        </Style>

        <!-- ======== THIN VERTICAL TOOLBAR SEPARATOR ======== -->
        <Style Selector="Rectangle.toolSep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource NexusBorderLight}" />
        </Style>

        <!-- ======== SIDEBAR ======== -->
        <Style Selector="TextBlock.sidebarHeader">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NexusSidebarHeaderForeground}" />
            <Setter Property="Margin" Value="16,18,0,6" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="Button.sidebarGroupHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sidebarGroupHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSidebarItemHover}" />
        </Style>
        <Style Selector="Button.sidebarNewGroup">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource NexusSidebarHeaderForeground}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sidebarNewGroup:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSidebarItemHover}" />
        </Style>

        <!-- ======== SEARCH BOX (pill, accent on focus) ======== -->
        <Style Selector="TextBox.searchBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource NexusSearchBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource NexusSearchBackground}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.searchBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource NexusSearchFocusBorder}" />
            <Setter Property="Background" Value="{DynamicResource NexusSearchFocusBackground}" />
        </Style>

        <!-- ======== TEXT INPUTS ======== -->
        <Style Selector="TextBox.nexusInput">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource NexusInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource NexusInputBackground}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="TextBox.nexusInput:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource NexusInputFocusBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="TextBox.nexusInput:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource NexusInputHoverBorder}" />
        </Style>

        <!-- Inline rename -->
        <Style Selector="TextBox.inlineRename">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="{DynamicResource NexusBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource NexusInputBackground}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="TextBox.inlineRename:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource NexusFocusBorder}" />
        </Style>

        <!-- ======== BROWSER-STYLE TABS (equal width, rounded top, accent underline) ======== -->
        <Style Selector="Border.tabItem">
            <Setter Property="Width" Value="190" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,6,0" />
            <Setter Property="CornerRadius" Value="10,10,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.tabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>
        <Style Selector="Border.tabItem.active, Border.tabItem.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource NexusGlassSurface}" />
        </Style>

        <Style Selector="Border.tabItem fluent|SymbolIcon.tabIcon">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource NexusTextSecondary}" />
        </Style>
        <Style Selector="Border.tabItem.active fluent|SymbolIcon.tabIcon">
            <Setter Property="Foreground" Value="{DynamicResource NexusAccent}" />
        </Style>

        <Style Selector="Border.tabItem TextBlock.tabTitle">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource NexusTextSecondary}" />
        </Style>
        <Style Selector="Border.tabItem.active TextBlock.tabTitle">
            <Setter Property="Foreground" Value="{DynamicResource NexusText}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Border.tabItem Border.tabIndicator">
            <Setter Property="Height" Value="2" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Margin" Value="4,0,28,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{DynamicResource NexusAccent}" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.tabItem.active Border.tabIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button.tabClose">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource NexusTabCloseButton}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.tabClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>

        <!-- ======== FILE GRID / LIST SELECTION ======== -->
        <Style Selector="Border.fileGridItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>

        <Style Selector="ListBox.fileListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSelection}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.fileListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="ListBox.fileListBox ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusSelectionHover}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <!-- ============================================================ -->
    <!-- MAIN LAYOUT                                                   -->
    <!-- ============================================================ -->
    <Panel>
        <!-- Resize grips (SystemDecorations=None removes OS resize borders).
             These sit in the transparent outer margin around the rounded shell. -->
        <Grid Name="ResizeGripLayer" IsVisible="True"
              RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
            <Grid.Styles>
                <Style Selector="Border.grip">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Grid.Styles>
            <Border Grid.Row="0" Grid.Column="0" Classes="grip" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="0" Grid.Column="1" Classes="grip" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="0" Grid.Column="2" Classes="grip" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="1" Grid.Column="0" Classes="grip" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="1" Grid.Column="2" Classes="grip" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="0" Classes="grip" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="1" Classes="grip" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeGrip_PointerPressed" />
            <Border Grid.Row="2" Grid.Column="2" Classes="grip" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeGrip_PointerPressed" />
        </Grid>

        <!-- Window chrome: rounded glass shell. The outer margin lets the rounded
             corners + drop shadow float over the transparent window background.
             Margin/CornerRadius are flattened to 0 when maximized (code-behind). -->
        <Border Name="ChromeBorder"
                Margin="1"
                CornerRadius="12" BorderBrush="{DynamicResource NexusBorder}" BorderThickness="1"
                ClipToBounds="True">
            <Panel>
                <!-- Real blur backdrop (acrylic/mica) -->
                <ExperimentalAcrylicBorder IsHitTestVisible="False">
                    <ExperimentalAcrylicBorder.Material>
                        <ExperimentalAcrylicMaterial
                            BackgroundSource="Digger"
                            TintColor="{DynamicResource NexusAcrylicTint}"
                            TintOpacity="1"
                            MaterialOpacity="{DynamicResource NexusAcrylicOpacity}" />
                    </ExperimentalAcrylicBorder.Material>
                </ExperimentalAcrylicBorder>

                <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- ====================================================== -->
                <!-- ROW 0: UNIFIED TITLEBAR + TABS (macOS style)            -->
                <!-- Traffic lights left, pill tabs, empty drag center        -->
                <!-- ====================================================== -->
                <Border Grid.Row="0" IsHitTestVisible="True"
                        Name="TitleBarArea"
                        Padding="0,6,0,0"
                        Background="Transparent">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" MinHeight="40">
                        <!-- LEFT: Traffic light buttons (close/minimize/maximize) -->
                        <!-- LEFT: App icon (subtle branding) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    Margin="14,0,0,0" VerticalAlignment="Center">
                            <Image Source="/Assets/icon.png" Width="16" Height="16" Opacity="0.7" />
                        </StackPanel>

                        <!-- Small gap before tabs -->
                        <Panel Grid.Column="1" Width="8" />

                        <!-- TABS: browser-style tabs (equal width) + New tab button (scrollable for overflow) -->
                        <ScrollViewer Grid.Column="2"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalAlignment="Bottom"
                                      Name="TabScrollViewer"
                                      PointerWheelChanged="TabScroll_PointerWheelChanged">
                            <StackPanel Orientation="Horizontal" Spacing="2"
                                        Name="TabBarArea"
                                        DoubleTapped="TabBar_DoubleTapped">
                                <ItemsControl ItemsSource="{Binding Tabs}" Name="TabItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="tabItem"
                                                    Classes.active="{Binding IsActive}"
                                                    PointerPressed="Tab_PointerPressed"
                                                    PointerMoved="Tab_PointerMoved"
                                                    PointerReleased="Tab_PointerReleased"
                                                    DragDrop.AllowDrop="True"
                                                    DragDrop.DragOver="TabItem_DragOver"
                                                    DragDrop.Drop="TabItem_Drop"
                                                    ToolTip.Tip="{Binding Title}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Duplicate Tab" Click="TabCtx_DuplicateTab">
                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="TabAdd" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Close Tab" Click="TabCtx_CloseTab">
                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Dismiss" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close Other Tabs" Click="TabCtx_CloseOtherTabs">
                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="TabDesktopMultiple" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close All Tabs" Click="TabCtx_CloseAllTabs">
                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="DismissSquareMultiple" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Panel>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <!-- Folder icon: tinted with the folder's custom color when it has one,
                                                             otherwise accent (active) / gray (inactive) via styles. -->
                                                        <Panel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <fluent:SymbolIcon Classes="tabIcon" Symbol="Folder" IconVariant="Filled"
                                                                               IsVisible="{Binding FolderColor, Converter={x:Static vm:IsNullConverter.Instance}}" />
                                                            <fluent:SymbolIcon Symbol="Folder" IconVariant="Filled" FontSize="15"
                                                                               Foreground="{Binding FolderColor, Converter={x:Static vm:FolderColorBrushConverter.Instance}}"
                                                                               IsVisible="{Binding FolderColor, Converter={x:Static vm:HasFolderColorConverter.Instance}}" />
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Classes="tabTitle" Text="{Binding Title}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="2" Classes="tabClose" Content="&#xE8BB;"
                                                                ToolTip.Tip="Close Tab"
                                                                AutomationProperties.Name="Close Tab"
                                                                Click="TabClose_Click" />
                                                    </Grid>
                                                    <!-- Accent underline (active tab only) -->
                                                    <Border Classes="tabIndicator" />
                                                </Panel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- New Tab: simple circle right after tabs -->
                                <Button Command="{Binding NewTabCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource NexusTabCloseButton}"
                                        Padding="0" Width="24" Height="24"
                                        CornerRadius="12"
                                        FontSize="16" FontWeight="Light"
                                        Content="+" Cursor="Hand"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="New Tab (Ctrl+T)"
                                        AutomationProperties.Name="New Tab" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT: App icon (subtle branding) -->
                        <!-- RIGHT: Square window buttons (minimize / maximize / close), Windows order -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                    VerticalAlignment="Center" Spacing="4" Margin="6,0,12,0">
                            <StackPanel.Styles>
                                <Style Selector="Button.captionBtn">
                                    <Setter Property="Width" Value="26" />
                                    <Setter Property="Height" Value="26" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="13" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{DynamicResource NexusTextSecondary}" />
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
                                    <Setter Property="FontSize" Value="9" />
                                </Style>
                                <Style Selector="Button.captionBtn:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource NexusHover}" />
                                </Style>
                                <!-- Close button turns red on hover, like Windows -->
                                <Style Selector="Button.captionClose:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#E81123" />
                                    <Setter Property="TextElement.Foreground" Value="White" />
                                </Style>
                            </StackPanel.Styles>

                            <Button Name="MinimizeButton" Classes="captionBtn" Content="&#xE921;"
                                    ToolTip.Tip="Minimize" Click="MinimizeButton_Click"
                                    AutomationProperties.Name="Minimize Window" />
                            <Button Name="MaximizeButton" Classes="captionBtn" Content="&#xE922;"
                                    ToolTip.Tip="Maximize" Click="MaximizeButton_Click"
                                    AutomationProperties.Name="Maximize Window" />
                            <Button Name="CloseButton" Classes="captionBtn captionClose" Content="&#xE8BB;"
                                    ToolTip.Tip="Close" Click="CloseButton_Click"
                                    AutomationProperties.Name="Close Window" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ====================================================== -->
                <!-- ROW 1: TOOLBAR (Modern grouped controls + dark address) -->
                <!-- ====================================================== -->
                <Border Grid.Row="1" Padding="12,6"
                        Background="Transparent">

                    <DockPanel>
                        <!-- RIGHT CLUSTER (uniform icon buttons): progress · search · view · actions · settings -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center" Margin="8,0,0,0">

                            <!-- Files / Project content toggle (Project Explorer is an alternative view) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Button Classes="segBtn segBtnFirst"
                                        Command="{Binding ShowFilesContentCommand}"
                                        ToolTip.Tip="Files"
                                        AutomationProperties.Name="Files view"
                                        Background="{Binding ContentMode, Converter={x:Static vm:ContentModeActiveBackgroundConverter.Instance}, ConverterParameter=Files}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <fluent:SymbolIcon Symbol="Folder" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Files" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="segBtn segBtnLast"
                                        Command="{Binding ShowProjectContentCommand}"
                                        ToolTip.Tip="Project Explorer"
                                        AutomationProperties.Name="Project view"
                                        Background="{Binding ContentMode, Converter={x:Static vm:ContentModeActiveBackgroundConverter.Instance}, ConverterParameter=Project}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <fluent:SymbolIcon Symbol="Box" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Project" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- File operation progress (only visible while an operation runs) -->
                            <Button Classes="toolIcon"
                                    IsVisible="{Binding IsOperationIndicatorVisible}"
                                    Command="{Binding ShowFileOperationCenterCommand}"
                                    ToolTip.Tip="{Binding OperationSummaryText}"
                                    AutomationProperties.Name="File operations">
                                <Grid Width="18" Height="18">
                                    <controls:CircularProgressControl Value="{Binding OverallProgress}"
                                                                      TrackBrush="{DynamicResource NexusProgressTrack}"
                                                                      ProgressBrush="{DynamicResource NexusAccent}"
                                                                      StrokeThickness="2" />
                                    <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:F0}%'}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="7" FontWeight="SemiBold"
                                               Foreground="{DynamicResource NexusText}" />
                                </Grid>
                            </Button>

                            <!-- 1. Search icon + floating input (Popup takes no space in the bar) -->
                            <Panel>
                                <Button Classes="toolIcon" Name="SearchToggleButton"
                                        Click="SearchToggle_Click"
                                        ToolTip.Tip="Search (Ctrl+F)"
                                        AutomationProperties.Name="Search">
                                    <fluent:SymbolIcon Symbol="Search" />
                                </Button>
                                <Popup Name="SearchPopup"
                                       PlacementTarget="{Binding #SearchToggleButton}"
                                       Placement="BottomEdgeAlignedRight"
                                       VerticalOffset="6"
                                       IsLightDismissEnabled="True"
                                       Closed="SearchPopup_Closed">
                                    <Border Background="{DynamicResource NexusDialogBackground}"
                                            BorderBrush="{DynamicResource NexusBorderLight}" BorderThickness="1"
                                            CornerRadius="12" Padding="5"
                                            BoxShadow="0 8 24 -4 #40000000">
                                        <TextBox Classes="searchBox" Width="250"
                                                 MinHeight="28" Height="28"
                                                 Padding="8,2" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding SearchQuery, Mode=TwoWay}"
                                                 Watermark="Search"
                                                 Name="SearchBoxTextBox"
                                                 AutomationProperties.Name="Search files and folders"
                                                 KeyDown="SearchBox_KeyDown"
                                                 TextChanged="SearchBox_TextChanged">
                                            <TextBox.InnerLeftContent>
                                                <fluent:SymbolIcon Symbol="Search" FontSize="12" Margin="6,0,2,0"
                                                                   Foreground="{DynamicResource NexusSearchIcon}" />
                                            </TextBox.InnerLeftContent>
                                        </TextBox>
                                    </Border>
                                </Popup>
                            </Panel>

                            <!-- 2. View / layout dropdown: shows the active mode's icon; menu is icons only. -->
                            <Button Classes="toolIcon" ToolTip.Tip="View / Layout"
                                    AutomationProperties.Name="View and layout">
                                <fluent:SymbolIcon>
                                    <fluent:SymbolIcon.Symbol>
                                        <MultiBinding Converter="{x:Static vm:ActiveViewIconConverter.Instance}">
                                            <Binding Path="ViewMode" />
                                            <Binding Path="LayoutMode" />
                                        </MultiBinding>
                                    </fluent:SymbolIcon.Symbol>
                                </fluent:SymbolIcon>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight"
                                            FlyoutPresenterClasses="compactFlyout">
                                        <StackPanel Spacing="2">
                                            <StackPanel.Styles>
                                                <Style Selector="Button.viewOpt">
                                                    <Setter Property="Width" Value="36" />
                                                    <Setter Property="Height" Value="34" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </Style>
                                                <Style Selector="Button.viewOpt fluent|SymbolIcon">
                                                    <Setter Property="FontSize" Value="16" />
                                                    <Setter Property="Foreground" Value="{DynamicResource NexusNavBtnForeground}" />
                                                </Style>
                                                <Style Selector="Button.viewOpt:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource NexusHover}" />
                                                </Style>
                                            </StackPanel.Styles>
                                            <Button Classes="viewOpt" Tag="Icons" Click="ViewOption_Click" ToolTip.Tip="Icons" AutomationProperties.Name="Icons">
                                                <fluent:SymbolIcon Symbol="Grid" />
                                            </Button>
                                            <Button Classes="viewOpt" Tag="Details" Click="ViewOption_Click" ToolTip.Tip="Details" AutomationProperties.Name="Details">
                                                <fluent:SymbolIcon Symbol="AppsList" />
                                            </Button>
                                            <Button Classes="viewOpt" Tag="Split" Click="ViewOption_Click" ToolTip.Tip="Split terminal" AutomationProperties.Name="Split terminal">
                                                <fluent:SymbolIcon Symbol="PanelRight" />
                                            </Button>
                                            <Button Classes="viewOpt" Tag="Terminal" Click="ViewOption_Click" ToolTip.Tip="Terminal" AutomationProperties.Name="Terminal">
                                                <fluent:SymbolIcon Symbol="WindowConsole" />
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <!-- 3. Actions -->
                            <Button Classes="toolIcon" ToolTip.Tip="Actions"
                                    AutomationProperties.Name="Actions">
                                <fluent:SymbolIcon Symbol="Options" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Empty Recycle Bin" Command="{Binding EmptyRecycleBinCommand}"
                                                  IsVisible="{Binding IsRecycleBinView}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsRecycleBinView}" />
                                        <MenuItem Header="New Folder" Command="{Binding CreateFolderCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="FolderAdd" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New File" Command="{Binding CreateFileCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="DocumentAdd" /></MenuItem.Icon>
                                        </MenuItem>
                                        <!-- New (dynamic: shell-discovered templates + built-ins) -->
                                        <MenuItem Header="New" ItemsSource="{Binding NewMenuItems}"
                                                  Tag="{Binding}"
                                                  IsVisible="{Binding HasNewMenuItems}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Add" /></MenuItem.Icon>
                                            <MenuItem.Styles>
                                                <Style Selector="MenuItem > MenuItem">
                                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                                    <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.CreateFromNewItemCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="Icon">
                                                        <Template>
                                                            <Panel>
                                                                <fluent:SymbolIcon Symbol="{Binding FallbackSymbol}" FontSize="14"
                                                                                   IsVisible="{Binding Icon, Converter={x:Static vm:IsNullConverter.Instance}}" />
                                                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                                                       IsVisible="{Binding Icon, Converter={x:Static vm:IsNotNullConverter.Instance}}" />
                                                            </Panel>
                                                        </Template>
                                                    </Setter>
                                                </Style>
                                            </MenuItem.Styles>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Show Item Information" Command="{Binding ToggleShowItemInfoCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Info" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show Hidden Files" Command="{Binding ToggleShowHiddenFilesCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Eye" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show/Hide Preview" Command="{Binding TogglePreviewCommand}" InputGesture="Ctrl+P">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="PanelRight" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Sort by Name" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Name}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="TextSortAscending" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort by Date" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.DateModified}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Calendar" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort by Size" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Size}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Ruler" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort by Type" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Type}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Tag" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort by Color" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Color}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Color" /></MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <!-- 4. Settings -->
                            <Button Classes="toolIcon" ToolTip.Tip="Settings"
                                    AutomationProperties.Name="Settings"
                                    Command="{Binding OpenSettingsCommand}">
                                <fluent:SymbolIcon Symbol="Settings" />
                            </Button>
                        </StackPanel>

                        <!-- LEFT (fills remaining space): Directory bar with Back/Forward + breadcrumbs -->
                        <Border Classes.edit="{Binding IsAddressBarEditing}"
                                Background="{DynamicResource NexusAddressBarBackground}"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource NexusAddressBarBorder}"
                                BorderThickness="1"
                                Padding="0" Margin="0"
                                MinHeight="34"
                                VerticalAlignment="Center"
                                DoubleTapped="AddressBar_DoubleTapped">
                            <Border.Styles>
                                <Style Selector="Border.edit">
                                    <Setter Property="BorderBrush" Value="{DynamicResource NexusAddressBarEditBorder}" />
                                </Style>
                            </Border.Styles>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy address" Command="{Binding CopyCurrentPathCommand}">
                                        <MenuItem.Icon><fluent:SymbolIcon Symbol="Copy" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Edit address" Command="{Binding StartAddressBarEditCommand}">
                                        <MenuItem.Icon><fluent:SymbolIcon Symbol="Edit" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                                <!-- Back / Forward inside the directory bar -->
                                <Button Grid.Column="0" Classes="navBtn" Margin="4,0,0,0"
                                        Padding="6,5" MinWidth="28" MinHeight="26"
                                        Command="{Binding GoBackCommand}"
                                        IsEnabled="{Binding CanGoBack}"
                                        ToolTip.Tip="Back (Alt+Left)">
                                    <fluent:SymbolIcon Symbol="ArrowLeft" FontSize="13" Foreground="{DynamicResource NexusBreadcrumbIcon}" />
                                </Button>
                                <Button Grid.Column="1" Classes="navBtn" Margin="0,0,4,0"
                                        Padding="6,5" MinWidth="28" MinHeight="26"
                                        Command="{Binding GoForwardCommand}"
                                        IsEnabled="{Binding CanGoForward}"
                                        ToolTip.Tip="Forward (Alt+Right)">
                                    <fluent:SymbolIcon Symbol="ArrowRight" FontSize="13" Foreground="{DynamicResource NexusBreadcrumbIcon}" />
                                </Button>

                                <Panel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <!-- Breadcrumb path (visible when not editing) -->
                                <ScrollViewer IsVisible="{Binding !IsAddressBarEditing}"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalAlignment="Left"
                                              Name="BreadcrumbScrollViewer">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="2,0">
                                        <!-- Breadcrumb segments (dimmed path, bold current dir) -->
                                        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BreadcrumbItem">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Chevron separator (hidden before the first segment) -->
                                                        <TextBlock Text="&#x203A;" VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource NexusBreadcrumbSeparator}"
                                                                   Margin="3,0"
                                                                   IsVisible="{Binding !IsFirst}" />
                                                        <!-- Clickable segment: last item is bold+highlighted, others dimmed -->
                                                        <Button Command="{Binding DataContext.BreadcrumbNavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0"
                                                                Padding="5,3" FontSize="12"
                                                                Cursor="Hand" CornerRadius="5">
                                                            <Panel>
                                                                <!-- Parent segment: dimmed foreground -->
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource NexusBreadcrumbForeground}"
                                                                           IsVisible="{Binding !IsLast}" />
                                                                <!-- Current segment: bold, active foreground -->
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="12" FontWeight="Bold"
                                                                           Foreground="{DynamicResource NexusBreadcrumbActiveForeground}"
                                                                           IsVisible="{Binding IsLast}" />
                                                            </Panel>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <!-- Clickable overlay removed — double-click handled by parent address bar Border -->
                                <!-- Text editing mode: full-width input -->
                                <TextBox Name="AddressBarTextBox" Text="{Binding AddressBarText, Mode=TwoWay}"
                                         IsVisible="{Binding IsAddressBarEditing}"
                                         AutomationProperties.Name="Address bar - enter path"
                                         FontSize="12"
                                         Foreground="{DynamicResource NexusTextPrimary}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="10,6"
                                         VerticalContentAlignment="Center"
                                         KeyDown="AddressBar_KeyDown" LostFocus="AddressBar_LostFocus" />
                                </Panel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ====================================================== -->
                <!-- ROW 2: BODY (Sidebar + Content + Terminal)              -->
                <!-- ====================================================== -->
                <Grid Grid.Row="2" ColumnDefinitions="195,Auto,*" Margin="10,2,10,8">

                    <!-- ====== SIDEBAR (floating rounded glass card) ====== -->
                    <Border Grid.Column="0"
                            Name="SidebarBorder"
                            Background="{DynamicResource NexusGlassSurface}"
                            BorderBrush="{DynamicResource NexusGlassBorder}" BorderThickness="1"
                            CornerRadius="16" ClipToBounds="True"
                            AutomationProperties.Name="Navigation sidebar">
                        <Grid RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SidebarGroups}" Margin="0,8,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SidebarGroup">
                                            <StackPanel>
                                                <!-- Group header (collapsible, keyboard accessible) -->
                                                <Button Classes="sidebarGroupHeader"
                                                        Click="SidebarGroupHeader_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu x:CompileBindings="False">
                                                            <MenuItem Header="Rename Group"
                                                                      Command="{Binding $parent[Window].DataContext.RenameGroupCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding !IsSystem}">
                                                                <MenuItem.Icon><fluent:SymbolIcon Symbol="Rename" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Delete Group"
                                                                      Command="{Binding $parent[Window].DataContext.DeleteGroupCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding !IsSystem}">
                                                                <MenuItem.Icon><fluent:SymbolIcon Symbol="Delete" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Move Up"
                                                                      Command="{Binding $parent[Window].DataContext.MoveGroupUpCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding !IsSystem}">
                                                                <MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowUp" /></MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Move Down"
                                                                      Command="{Binding $parent[Window].DataContext.MoveGroupDownCommand}"
                                                                      CommandParameter="{Binding}"
                                                                      IsVisible="{Binding !IsSystem}">
                                                                <MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowDown" /></MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding IsExpanded, Converter={x:Static vm:IsExpandedToGlyphConverter.Instance}}"
                                                                   FontSize="10" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource NexusSidebarHeaderForeground}" />
                                                        <TextBlock Text="{Binding Name}" Classes="sidebarHeader" Margin="0" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Group items -->
                                                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:NavigationItem">
                                                            <Border Padding="12,8" Margin="8,2" CornerRadius="8"
                                                                    Background="Transparent" Cursor="Hand"
                                                                    Opacity="{Binding IsAvailable, Converter={x:Static vm:IsAvailableToOpacityConverter.Instance}}"
                                                                    PointerPressed="SidebarItem_PointerPressed">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu x:CompileBindings="False">
                                                                        <MenuItem Header="Unpin from Quick Access"
                                                                                  Command="{Binding $parent[Window].DataContext.UnpinFromFavoritesCommand}"
                                                                                  CommandParameter="{Binding Path}"
                                                                                  IsVisible="{Binding Kind, Converter={x:Static vm:IsFavoriteKindConverter.Instance}}">
                                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="PinOff" /></MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Remove from Group"
                                                                                  Command="{Binding $parent[Window].DataContext.RemoveFromGroupCommand}"
                                                                                  CommandParameter="{Binding}"
                                                                                  IsVisible="{Binding Kind, Converter={x:Static vm:IsCustomItemConverter.Instance}}">
                                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Dismiss" /></MenuItem.Icon>
                                                                        </MenuItem>
                                                                        <MenuItem Header="Open in New Tab"
                                                                                  Command="{Binding $parent[Window].DataContext.NewTabAtPathCommand}"
                                                                                  CommandParameter="{Binding Path}">
                                                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="TabAdd" /></MenuItem.Icon>
                                                                        </MenuItem>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                                    <!-- Color swatch for color-group entries -->
                                                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                                                             IsVisible="{Binding ColorHex, Converter={x:Static vm:HasFolderColorConverter.Instance}}"
                                                                             Fill="{Binding ColorHex, Converter={x:Static vm:FolderColorBrushConverter.Instance}}" />
                                                                    <fluent:SymbolIcon Symbol="{Binding Name, Converter={x:Static vm:NavigationNameToIconConverter.Instance}}"
                                                                                       Foreground="{DynamicResource NexusSidebarItemForeground}"
                                                                                       FontSize="16" VerticalAlignment="Center" IconVariant="Regular"
                                                                                       IsVisible="{Binding ColorHex, Converter={x:Static vm:IsNullConverter.Instance}}" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource NexusSidebarItemForeground}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- New Group -->
                            <Button Grid.Row="1" Classes="sidebarNewGroup" Margin="12,0,12,10"
                                    Command="{Binding NewGroupCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="Add" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource NexusSidebarHeaderForeground}" />
                                    <TextBlock Text="New Group" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Sidebar splitter (resizable, gap between floating cards) -->
                    <GridSplitter Grid.Column="1" Width="10" Background="Transparent"
                                  ResizeDirection="Columns" />

                    <!-- ====== CONTENT GRID (Explorer | Splitter | Terminal) ====== -->
                    <Grid Grid.Column="2" Name="ContentGrid"
                          ColumnDefinitions="*,0,0"
                          RowDefinitions="*,0,0">

                        <!-- === EXPLORER GRID (FileView | PreviewSplitter | Preview) === -->
                        <!-- The preview column has a MinWidth so the splitter can't shrink it
                             small enough for the preview cards to overflow/clip. -->
                        <Grid Grid.Column="0" Name="ExplorerGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="320" />
                                <ColumnDefinition Width="0" />
                                <!-- MinWidth is toggled in code-behind (UpdatePreviewLayout):
                                     240 when the preview is shown, 0 when hidden. -->
                                <ColumnDefinition Width="0" />
                            </Grid.ColumnDefinitions>

                            <!-- File content area (floating rounded glass card) -->
                            <Border Grid.Column="0" Background="{DynamicResource NexusGlassSurface}" Padding="0"
                                    BorderBrush="{DynamicResource NexusGlassBorder}" BorderThickness="1"
                                    CornerRadius="16" ClipToBounds="True"
                                    behaviors:DragDropBehavior.IsEnabled="True">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="View">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Grid" /></MenuItem.Icon>
                                            <MenuItem Header="Extra Large Icons" Command="{Binding SetExtraLargeIconsViewCommand}" />
                                            <MenuItem Header="Large Icons" Command="{Binding SetLargeIconsViewCommand}" />
                                            <MenuItem Header="Medium Icons" Command="{Binding SetMediumIconsViewCommand}" />
                                            <MenuItem Header="Small Icons" Command="{Binding SetSmallIconsViewCommand}" />
                                            <MenuItem Header="Details" Command="{Binding SetDetailsViewCommand}" />
                                        </MenuItem>
                                        <MenuItem Header="Sort by">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowSort" /></MenuItem.Icon>
                                            <MenuItem Header="Name" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Name}" />
                                            <MenuItem Header="Date modified" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.DateModified}" />
                                            <MenuItem Header="Type" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Type}" />
                                            <MenuItem Header="Size" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Size}" />
                                            <MenuItem Header="Color" Command="{Binding SetSortModeCommand}" CommandParameter="{x:Static models:FileSortMode.Color}" />
                                            <Separator />
                                            <MenuItem Header="Ascending" Command="{Binding SetSortDirectionCommand}" CommandParameter="{x:Static models:SortDirection.Ascending}" />
                                            <MenuItem Header="Descending" Command="{Binding SetSortDirectionCommand}" CommandParameter="{x:Static models:SortDirection.Descending}" />
                                        </MenuItem>
                                        <MenuItem Header="Group by">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="GroupList" /></MenuItem.Icon>
                                            <MenuItem Header="None" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.None}" />
                                            <MenuItem Header="Name" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.Name}" />
                                            <MenuItem Header="Date modified" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.DateModified}" />
                                            <MenuItem Header="Type" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.Type}" />
                                            <MenuItem Header="Size" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.Size}" />
                                            <MenuItem Header="Color" Command="{Binding SetGroupModeCommand}" CommandParameter="{x:Static models:FileGroupMode.Color}" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Show hidden files" Command="{Binding ToggleShowHiddenFilesCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Eye" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}" InputGesture="F5">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowClockwise" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Paste" Command="{Binding PasteCommand}" IsEnabled="{Binding HasClipboardContent}" InputGesture="Ctrl+V">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="ClipboardPaste" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{Binding UndoDescription, TargetNullValue='Undo'}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="ArrowUndo" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Open in Terminal" Command="{Binding OpenCurrentInTerminalCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="WindowConsole" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open in Other Terminal" ItemsSource="{Binding AvailableTerminalProfiles}" Tag="{Binding}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Code" /></MenuItem.Icon>
                                            <MenuItem.Styles>
                                                <Style Selector="MenuItem > MenuItem">
                                                    <Setter Property="Header" Value="{Binding Name}" />
                                                    <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.OpenCurrentInOtherTerminalCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="Icon">
                                                        <Template>
                                                            <fluent:SymbolIcon Symbol="{Binding IconKey, Converter={x:Static vm:TerminalIconConverter.Instance}}" FontSize="14" />
                                                        </Template>
                                                    </Setter>
                                                </Style>
                                            </MenuItem.Styles>
                                        </MenuItem>
                                        <MenuItem Header="Pin to Quick Access" Command="{Binding PinCurrentFolderCommand}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Pin" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- New: Folder + Text Document are always present (built-ins in
                                             NewMenuItems); shell-discovered types are appended dynamically.
                                             Falls back to the two static items if discovery is unavailable. -->
                                        <MenuItem Header="New" ItemsSource="{Binding NewMenuItems}"
                                                  Tag="{Binding}"
                                                  IsVisible="{Binding HasNewMenuItems}">
                                            <MenuItem.Icon><fluent:SymbolIcon Symbol="Add" /></MenuItem.Icon>
                                            <MenuItem.Styles>
                                                <Style Selector="MenuItem > MenuItem">
                                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                                    <Setter Property="Command" Value="{Binding $parent[MenuItem].Tag.CreateFromNewItemCommand}" />
                                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                                    <Setter Property="Icon">
                                                        <Template>
                                                            <Panel>
                                                                <fluent:SymbolIcon Symbol="{Binding FallbackSymbol}" FontSize="14"
                                                                                   IsVisible="{Binding Icon, Converter={x:Static vm:IsNullConverter.Instance}}" />
                                                                <Image Source="{Binding Icon}" Width="16" Height="16"
                                                                       IsVisible="{Binding Icon, Converter={x:Static vm:IsNotNullConverter.Instance}}" />
                                                            </Panel>
                                                        </Template>
                                                    </Setter>
                                                </Style>
                                            </MenuItem.Styles>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Panel>
                                    <!-- State overlays -->
                                    <TextBlock Text="Loading..." IsVisible="{Binding IsLoading}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14" Foreground="{DynamicResource NexusTextTertiary}" />
                                    <TextBlock Text="This folder is empty" IsVisible="{Binding IsEmpty}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14" Foreground="{DynamicResource NexusTextTertiary}" />
                                    <StackPanel IsVisible="{Binding HasError}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="&#x26A0;" FontSize="32" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource NexusDanger}" />
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="13"
                                                   Foreground="{DynamicResource NexusTextSecondary}"
                                                   TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center" />
                                    </StackPanel>

                                    <!-- FileView (handles all view modes internally) -->
                                    <views:FileView DataContext="{Binding}"
                                                    IsVisible="{Binding ContentMode, Converter={x:Static vm:IsFilesContentModeConverter.Instance}}" />

                                    <!-- Project Explorer: logical view, alternative to the file listing. -->
                                    <views:ProjectExplorerView DataContext="{Binding ProjectExplorer}"
                                                               IsVisible="{Binding $parent[Window].DataContext.ContentMode, Converter={x:Static vm:IsProjectContentModeConverter.Instance}, FallbackValue=False}" />

                                    <!-- Rubber-band selection rectangle -->
                                    <Border Name="RubberBand" IsVisible="False"
                                            Background="{DynamicResource NexusRubberBandFill}"
                                            BorderBrush="{DynamicResource NexusRubberBandStroke}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False" />
                                </Panel>
                            </Border>

                            <!-- Preview splitter -->
                            <GridSplitter Grid.Column="1" Width="10" Background="Transparent"
                                          ResizeDirection="Columns"
                                          Name="PreviewSplitter" />

                            <!-- === PREVIEW PANEL (floating rounded glass card) === -->
                            <Border Grid.Column="2" Background="{DynamicResource NexusGlassSurface}"
                                    BorderBrush="{DynamicResource NexusGlassBorder}" BorderThickness="1"
                                    CornerRadius="16" ClipToBounds="True"
                                    Name="PreviewPanel" IsVisible="{Binding IsPreviewVisible}">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Preview header (always pinned top) -->
                                    <Border Grid.Row="0" Padding="16,14,16,10"
                                            Background="Transparent">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <fluent:SymbolIcon Symbol="Eye" FontSize="14"
                                                               Foreground="{DynamicResource NexusTextSecondary}" />
                                            <TextBlock Text="Preview" FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource NexusTextSecondary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty state (nothing selected) — pinned near the top -->
                                    <StackPanel Grid.Row="1"
                                                IsVisible="{Binding PreviewType, Converter={x:Static vm:IsNoPreviewConverter.Instance}}"
                                                Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Margin="0,56,0,0">
                                        <fluent:SymbolIcon Symbol="DocumentSearch" FontSize="40"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource NexusPreviewPlaceholder}" />
                                        <TextBlock Text="Select a file to preview"
                                                   FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource NexusPreviewPlaceholder}" />
                                    </StackPanel>

                                    <!-- Preview content.  HorizontalScrollBarVisibility=Disabled
                                         is important: it forces the content to the viewport width
                                         so metadata rows / cards wrap instead of overflowing the card. -->
                                    <!-- NOTE: the inset is a Margin on the StackPanel, NOT ScrollViewer.Padding.
                                         ScrollContentPresenter ignores Padding while measuring, so wrapping
                                         text was measured ~28px too wide and overflowed the card. -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsVisible="{Binding PreviewType, Converter={x:Static vm:HasSelectionPreviewConverter.Instance}}">
                                        <StackPanel Spacing="14" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                    Margin="14,4,14,14">

                                            <!-- ===== HERO: image thumbnail OR big file/folder icon ===== -->
                                            <!-- Image hero -->
                                            <Border IsVisible="{Binding PreviewType, Converter={x:Static vm:IsImagePreviewConverter.Instance}}"
                                                    Background="{DynamicResource NexusPreviewImageBackground}"
                                                    CornerRadius="10" Padding="10" MinHeight="140">
                                                <Image Source="{Binding PreviewImagePath, Converter={x:Static vm:PathToBitmapConverter.Instance}}"
                                                       MaxHeight="300" Stretch="Uniform" StretchDirection="DownOnly"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Icon hero (text / folder / unsupported — shown when there's no image).
                                                 FlatStyle=True uses the modern flat Fluent folder glyph to match the UI. -->
                                            <Border IsVisible="{Binding PreviewType, Converter={x:Static vm:IsIconPreviewConverter.Instance}}"
                                                    Background="{DynamicResource NexusPreviewImageBackground}"
                                                    CornerRadius="10" Padding="10" Height="128">
                                                <controls:FileIconControl Item="{Binding SelectedItem}" IconSize="64"
                                                                          UseThumbnails="True" FlatStyle="True"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                            </Border>

                                            <!-- ===== Title block (name + type) ===== -->
                                            <StackPanel IsVisible="{Binding PreviewType, Converter={x:Static vm:HasSelectionPreviewConverter.Instance}}"
                                                        Spacing="3">
                                                <TextBlock Text="{Binding PreviewFileName}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NexusPreviewFileName}"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PreviewFileType}" FontSize="11"
                                                           Foreground="{DynamicResource NexusTextSecondary}" />
                                            </StackPanel>

                                            <!-- ===== Details card: rich metadata rows ===== -->
                                            <Border Background="{DynamicResource NexusPreviewBackground}"
                                                    BorderBrush="{DynamicResource NexusPreviewBorder}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,8"
                                                    HorizontalAlignment="Stretch"
                                                    IsVisible="{Binding PreviewType, Converter={x:Static vm:HasSelectionPreviewConverter.Instance}}">
                                                <StackPanel Spacing="0">
                                                    <!-- Type-specific rows (dimensions, lines, counts…) -->
                                                    <ItemsControl ItemsSource="{Binding PreviewMetadata}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PreviewMetadataEntry">
                                                                <Grid ColumnDefinitions="90,*" Margin="0,4">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                                               Foreground="{DynamicResource NexusTextTertiary}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                                               Foreground="{DynamicResource NexusPreviewMetadata}"
                                                                               TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Common rows: size / modified / created -->
                                                    <Grid ColumnDefinitions="90,*" Margin="0,4"
                                                          IsVisible="{Binding PreviewFileSize, Converter={x:Static vm:IsNotNullConverter.Instance}}">
                                                        <TextBlock Grid.Column="0" Text="Size" FontSize="11"
                                                                   Foreground="{DynamicResource NexusTextTertiary}" />
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   Text="{Binding PreviewFileSize, Converter={x:Static vm:FileSizeConverter.Instance}}"
                                                                   Foreground="{DynamicResource NexusPreviewMetadata}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="90,*" Margin="0,4"
                                                          IsVisible="{Binding PreviewLastModified, Converter={x:Static vm:IsNotNullConverter.Instance}}">
                                                        <TextBlock Grid.Column="0" Text="Modified" FontSize="11"
                                                                   Foreground="{DynamicResource NexusTextTertiary}" />
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   Text="{Binding PreviewLastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                   Foreground="{DynamicResource NexusPreviewMetadata}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="90,*" Margin="0,4"
                                                          IsVisible="{Binding PreviewCreated, Converter={x:Static vm:IsNotNullConverter.Instance}}">
                                                        <TextBlock Grid.Column="0" Text="Created" FontSize="11"
                                                                   Foreground="{DynamicResource NexusTextTertiary}" />
                                                        <TextBlock Grid.Column="1" FontSize="11"
                                                                   Text="{Binding PreviewCreated, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                   Foreground="{DynamicResource NexusPreviewMetadata}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- ===== Body: text content or folder listing ===== -->
                                            <StackPanel IsVisible="{Binding PreviewType, Converter={x:Static vm:HasPreviewBodyConverter.Instance}}"
                                                        Spacing="6">
                                                <TextBlock Text="Contents" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource NexusTextTertiary}" />
                                                <Border Background="{DynamicResource NexusPreviewTextBackground}" CornerRadius="8"
                                                        BorderBrush="{DynamicResource NexusPreviewTextBorder}" BorderThickness="1"
                                                        Padding="10" MaxHeight="380" ClipToBounds="True">
                                                    <!-- Vertical scroll only; wrapping keeps long lines inside the
                                                         card instead of overflowing to the right. -->
                                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding PreviewTextContent}"
                                                                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                                                                   Foreground="{DynamicResource NexusPreviewTextForeground}"
                                                                   TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>

                                            <!-- Unsupported note -->
                                            <TextBlock IsVisible="{Binding PreviewType, Converter={x:Static vm:IsUnsupportedPreviewConverter.Instance}}"
                                                       Text="No inline preview available for this file type."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource NexusPreviewPlaceholder}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Content split divider (between Explorer and Terminal) -->
                        <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource NexusSplitDivider}"
                                      Name="SplitDivider"
                                      IsVisible="{Binding LayoutMode, Converter={x:Static vm:IsSplitModeConverter.Instance}}" />

                        <!-- === TERMINAL PANEL === -->
                        <views:TerminalView Grid.Column="2" Name="TerminalPanel"
                                            DataContext="{Binding Terminal}" />
                    </Grid>
                </Grid>

                <!-- ====================================================== -->
                <!-- ROW 3: STATUS BAR (simplified, no duplicates)            -->
                <!-- ====================================================== -->
                <Border Grid.Row="3" Padding="18,5,18,8"
                        Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left: Status text (single source of truth) -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusText}"
                                   VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource NexusStatusBarText}" />

                        <!-- Right: Zoom slider (only visible in icon views) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ViewMode, Converter={x:Static vm:IsIconViewModeConverter.Instance}}">
                            <fluent:SymbolIcon Symbol="Image" FontSize="9"
                                               Foreground="{DynamicResource NexusStatusBarIcon}" />
                            <Slider Width="70" Minimum="0" Maximum="100"
                                    Value="{Binding IconZoomLevel, Mode=TwoWay}"
                                    VerticalAlignment="Center" Name="IconZoomSlider" />
                            <fluent:SymbolIcon Symbol="Image" FontSize="13"
                                               Foreground="{DynamicResource NexusStatusBarIcon}" />
                        </StackPanel>
                    </Grid>
                </Border>
                </Grid>
            </Panel>
        </Border>

        <!-- ============================================================ -->
        <!-- DELETE CONFIRMATION OVERLAY                                    -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsDeleteConfirmationVisible}" IsHitTestVisible="{Binding IsDeleteConfirmationVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Confirm Delete" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <TextBlock Text="{Binding DeleteConfirmationMessage}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource NexusDialogText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"
                                Classes="navBtn" Padding="16,7" FontSize="13" />
                        <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}"
                                Padding="16,7" FontSize="13"
                                Background="{DynamicResource NexusDangerBackground}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- TERMINAL CLOSE CONFIRMATION OVERLAY                           -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsTerminalCloseConfirmVisible}" IsHitTestVisible="{Binding IsTerminalCloseConfirmVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Terminal Process Running" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <TextBlock Text="A process is still running in this tab's terminal. Closing the tab will terminate it. Are you sure?"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource NexusDialogText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelTerminalCloseCommand}"
                                Classes="navBtn" Padding="16,7" FontSize="13" />
                        <Button Content="Close Tab" Command="{Binding ConfirmTerminalCloseCommand}"
                                Padding="16,7" FontSize="13"
                                Background="{DynamicResource NexusDangerBackground}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- CREATE FOLDER/FILE DIALOG OVERLAY                             -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsCreateDialogVisible}" IsHitTestVisible="{Binding IsCreateDialogVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding CreateDialogTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Name:" FontSize="12" Foreground="{DynamicResource NexusDialogLabel}" />
                        <TextBox Classes="nexusInput" Text="{Binding CreateDialogName, Mode=TwoWay}"
                                 Name="CreateDialogTextBox"
                                 AttachedToVisualTree="CreateDialogTextBox_Attached"
                                 KeyDown="CreateDialogTextBox_KeyDown" />
                    </StackPanel>
                    <!-- Error message -->
                    <TextBlock Text="{Binding CreateDialogError}" FontSize="11"
                               Foreground="{DynamicResource NexusDangerBackground}" TextWrapping="Wrap"
                               IsVisible="{Binding CreateDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCreateCommand}"
                                Padding="16,7" FontSize="13" />
                        <Button Content="Create" Command="{Binding ConfirmCreateCommand}"
                                Padding="16,7" FontSize="13"
                                Background="{DynamicResource NexusAccent}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- SIDEBAR GROUP DIALOG (New / Rename Group)                    -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsGroupDialogVisible}" IsHitTestVisible="{Binding IsGroupDialogVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="380" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding GroupDialogTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Group name:" FontSize="12" Foreground="{DynamicResource NexusDialogLabel}" />
                        <TextBox Classes="nexusInput" Text="{Binding GroupDialogName, Mode=TwoWay}"
                                 Name="GroupDialogTextBox"
                                 KeyDown="GroupDialogTextBox_KeyDown" />
                    </StackPanel>
                    <!-- Error message -->
                    <TextBlock Text="{Binding GroupDialogError}" FontSize="11"
                               Foreground="{DynamicResource NexusDangerBackground}" TextWrapping="Wrap"
                               IsVisible="{Binding GroupDialogError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelGroupDialogCommand}"
                                Padding="16,7" FontSize="13" />
                        <Button Content="{Binding GroupDialogConfirmText}" Command="{Binding ConfirmGroupDialogCommand}"
                                Padding="16,7" FontSize="13"
                                Background="{DynamicResource NexusAccent}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- MOVE TO / COPY TO DIALOG (mini folder browser)               -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsMoveToDialogVisible}" IsHitTestVisible="{Binding IsMoveToDialogVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="450" MaxWidth="550" MinHeight="380" MaxHeight="500"
                    BoxShadow="0 8 24 0 #50000000">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="{Binding MoveToDialogTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" Margin="0,0,0,12" />

                    <!-- Current path + Up button -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <Button Grid.Column="0" Classes="navBtn" Padding="6,4" Margin="0,0,8,0"
                                Command="{Binding MoveToGoUpCommand}" ToolTip.Tip="Go Up">
                            <fluent:SymbolIcon Symbol="ArrowUp" FontSize="12" Foreground="{DynamicResource NexusNavBtnForeground}" />
                        </Button>
                        <Border Grid.Column="1" Background="{DynamicResource NexusInputBackground}"
                                BorderBrush="{DynamicResource NexusInputBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="8,4">
                            <TextBlock Text="{Binding MoveToCurrentPath}" FontSize="11.5"
                                       Foreground="{DynamicResource NexusTextSecondary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Folder list -->
                    <Border Grid.Row="2" Background="{DynamicResource NexusInputBackground}"
                            BorderBrush="{DynamicResource NexusInputBorder}" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,0,12">
                        <ListBox ItemsSource="{Binding MoveToItems}" Background="Transparent"
                                 BorderThickness="0" DoubleTapped="MoveTo_FolderDoubleTapped"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,3">
                                        <fluent:SymbolIcon Symbol="Folder" FontSize="16" Foreground="{DynamicResource NexusAccent}" IconVariant="Filled" />
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{DynamicResource NexusText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelMoveToCommand}"
                                Padding="16,7" FontSize="13" />
                        <Button Content="{Binding MoveToDialogTitle}" Command="{Binding ConfirmMoveToCommand}"
                                Padding="16,7" FontSize="13"
                                Background="{DynamicResource NexusAccent}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>

        <!-- Compress/Extract/Send To now report through the shared File Operation Center below,
             so the old standalone progress overlay was removed. -->

        <!-- ============================================================ -->
        <!-- CONFLICT RESOLUTION OVERLAY                                   -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsConflictResolutionVisible}" IsHitTestVisible="{Binding IsConflictResolutionVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="420" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="File Conflict" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <TextBlock Text="{Binding ConflictMessage}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource NexusDialogText}" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" Margin="0,8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Source:" FontWeight="SemiBold" Margin="0,0,8,4" FontSize="12"
                                   Foreground="{DynamicResource NexusText}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConflictSourceInfo}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource NexusTextSecondary}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination:" FontWeight="SemiBold" Margin="0,0,8,0" FontSize="12"
                                   Foreground="{DynamicResource NexusText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConflictDestinationInfo}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource NexusTextSecondary}" />
                    </Grid>
                    <CheckBox Content="Apply to all remaining conflicts"
                              IsChecked="{Binding ApplyConflictToAll, Mode=TwoWay}"
                              FontSize="12" Foreground="{DynamicResource NexusDialogLabel}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Skip" Command="{Binding ResolveConflictCommand}" CommandParameter="Skip"
                                Classes="navBtn" Padding="14,6" FontSize="13" />
                        <Button Content="Replace" Command="{Binding ResolveConflictCommand}" CommandParameter="Replace"
                                Padding="14,6" FontSize="13" Background="{DynamicResource NexusAccent}" Foreground="White" CornerRadius="5" />
                        <Button Content="Keep Both" Command="{Binding ResolveConflictCommand}" CommandParameter="RenameAutomatically"
                                Classes="navBtn" Padding="14,6" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- FILE OPERATION CENTER (expanded, non-blocking)               -->
        <!-- ============================================================ -->
        <Border IsVisible="{Binding IsFileOperationCenterVisible}"
                Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="16"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="24,0,24,40" MinWidth="380" MaxWidth="460"
                BoxShadow="0 8 28 0 #50000000">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <TextBlock Text="File Operations" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="&#x2013;" FontSize="14" Padding="10,2"
                            Command="{Binding MinimizeFileOperationCenterCommand}"
                            Background="Transparent" BorderThickness="0" CornerRadius="6"
                            Foreground="{DynamicResource NexusTextSecondary}" Cursor="Hand"
                            ToolTip.Tip="Minimize" />
                </Grid>

                <!-- Operations list -->
                <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="{DynamicResource NexusBorderSubtle}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <fluent:SymbolIcon Grid.Column="0"
                                                           Symbol="{Binding OperationType, Converter={x:Static vm:FileOperationTypeToIconConverter.Instance}}"
                                                           FontSize="20" Foreground="{DynamicResource NexusAccent}"
                                                           VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource NexusText}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{DynamicResource NexusTextSecondary}" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100"
                                                         Height="5" Margin="0,4,0,0"
                                                         Foreground="{DynamicResource NexusProgressForeground}"
                                                         Background="{DynamicResource NexusProgressTrack}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                           Foreground="{DynamicResource NexusTextTertiary}" />
                                                <TextBlock Text="{Binding SpeedText}" FontSize="10"
                                                           Foreground="{DynamicResource NexusTextTertiary}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}"
                                                       FontSize="12" Foreground="{DynamicResource NexusText}" HorizontalAlignment="Right" />
                                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                                    Padding="8,2" FontSize="11" HorizontalAlignment="Right"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="5"
                                                    Foreground="{DynamicResource NexusDanger}" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- OPERATION INDICATOR (minimized state) lives in the toolbar    -->
        <!-- ============================================================ -->

        <!-- ============================================================ -->
        <!-- CLOSE CONFIRMATION OVERLAY (active operations)               -->
        <!-- ============================================================ -->
        <Panel IsVisible="{Binding IsCloseConfirmationVisible}" IsHitTestVisible="{Binding IsCloseConfirmationVisible}">
            <Border Background="{DynamicResource NexusDialogScrim}" />
            <Border Background="{DynamicResource NexusDialogBackground}" CornerRadius="10" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="440" BoxShadow="0 8 24 0 #50000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Operation in progress" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusText}" />
                    <TextBlock Text="{Binding CloseConfirmationMessage}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource NexusDialogText}" />
                    <StackPanel Spacing="8">
                        <Button Content="Continue using Nexus" Command="{Binding ContinueUsingCommand}"
                                Classes="navBtn" Padding="12,7" FontSize="13"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="Wait for operation to finish" Command="{Binding WaitForOperationCommand}"
                                Classes="navBtn" Padding="12,7" FontSize="13"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        <Button Content="Cancel operation and exit" Command="{Binding CancelAndExitCommand}"
                                Padding="12,7" FontSize="13"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{DynamicResource NexusDangerBackground}" Foreground="White" CornerRadius="5" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ============================================================ -->
        <!-- DRAG PREVIEW OVERLAY (follows cursor during drag)             -->
        <!-- ============================================================ -->
        <controls:DragPreviewControl Name="DragPreview"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     ZIndex="9999" />

    </Panel>
</Window>
