<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexusExplorer.App.ViewModels"
             xmlns:projects="using:NexusExplorer.Core.Models.Projects"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             x:Class="NexusExplorer.App.Views.ProjectExplorerView"
             x:DataType="vm:ProjectExplorerViewModel"
             x:Name="ProjectRoot"
             Background="{DynamicResource NexusGlassSurface}">

    <UserControl.Styles>
        <!-- Section header: compact, uppercase, muted — developer-tool feel. -->
        <Style Selector="TextBlock.projSectionTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NexusTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Entry row: subtle hover, hand cursor for actionable entries. -->
        <Style Selector="Border.projEntry">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.projEntry:pointerover">
            <Setter Property="Background" Value="{DynamicResource NexusHover}" />
        </Style>
        <!-- Information rows are not actionable: no hand cursor, no hover highlight. -->
        <Style Selector="Border.projEntry.info">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Border.projEntry.info:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Run button on command rows: appears on row hover, filled on its own hover. -->
        <Style Selector="Button.projRun">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource NexusAccentSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource NexusAccent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.projRun:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NexusAccent}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ============ NO PROJECT STATE ============ -->
        <StackPanel IsVisible="{Binding !HasProject}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" Margin="24">
            <fluent:SymbolIcon Symbol="Folder" FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource NexusTextTertiary}" />
            <TextBlock Text="No project detected"
                       FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource NexusText}" />
            <TextBlock Text="This folder doesn't look like a Node.js, .NET, Rust, or Python project."
                       FontSize="12" TextWrapping="Wrap" MaxWidth="320"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource NexusTextSecondary}" />
        </StackPanel>

        <!-- ============ PROJECT STATE ============ -->
        <ScrollViewer IsVisible="{Binding HasProject}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,16">
            <StackPanel Spacing="14">

                <!-- PROJECT HEADER -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Project.Name}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource NexusText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Project.PrimaryType, Converter={x:Static vm:ProjectTypeNameConverter.Instance}}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource NexusAccent}" />
                    <TextBlock Text="{Binding Project.DetectedTechnologies, Converter={x:Static vm:DetectedTechnologiesConverter.Instance}}"
                               FontSize="11"
                               Foreground="{DynamicResource NexusTextSecondary}" />
                    <TextBlock Text="{Binding Project.RootPath}"
                               FontSize="11"
                               FontFamily="Cascadia Mono,Consolas,monospace"
                               Foreground="{DynamicResource NexusTextTertiary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Rectangle Height="1" Fill="{DynamicResource NexusBorderLight}" />

                <!-- SECTIONS -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="projects:ProjectSection">
                            <StackPanel Spacing="2" Margin="0,0,0,10">
                                <!-- Section header -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,0,0,4">
                                    <fluent:SymbolIcon Symbol="{Binding Kind, Converter={x:Static vm:ProjectSectionIconConverter.Instance}}"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource NexusTextSecondary}" />
                                    <TextBlock Text="{Binding Title}" Classes="projSectionTitle" />
                                </StackPanel>

                                <!-- Section entries -->
                                <ItemsControl ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="projects:ProjectEntry">
                                            <Border Classes="projEntry"
                                                    Classes.info="{Binding Kind, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=Information}"
                                                    Tapped="ProjectEntry_Tapped"
                                                    Tag="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <fluent:SymbolIcon Grid.Column="0"
                                                                       Symbol="{Binding Kind, Converter={x:Static vm:ProjectEntryIconConverter.Instance}}"
                                                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"
                                                                       Foreground="{DynamicResource NexusTextSecondary}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource NexusText}" />
                                                        <!-- Command preview (scripts) -->
                                                        <TextBlock Text="{Binding Command.DisplayCommand}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                                                   Foreground="{DynamicResource NexusTextTertiary}"
                                                                   IsVisible="{Binding Command, Converter={x:Static vm:IsNotNullConverter.Instance}}" />
                                                    </StackPanel>
                                                    <!-- Run button: only for command entries; runs in the integrated terminal. -->
                                                    <Button Grid.Column="2" Classes="projRun"
                                                            Command="{Binding DataContext.RunCommandCommand, ElementName=ProjectRoot}"
                                                            CommandParameter="{Binding Command}"
                                                            IsVisible="{Binding Kind, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=Command}"
                                                            ToolTip.Tip="Run in terminal">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <fluent:SymbolIcon Symbol="Play" FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="Run" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
