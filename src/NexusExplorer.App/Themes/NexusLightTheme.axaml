<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- NEXUS EXPLORER — LIGHT THEME                                  -->
    <!-- macOS Mavericks / Finder inspired palette                     -->
    <!-- ============================================================ -->

    <!-- === Core Backgrounds === -->
    <SolidColorBrush x:Key="NexusBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NexusSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusSurfaceSecondary" Color="#F8F8F8" />
    <SolidColorBrush x:Key="NexusSurfaceTertiary" Color="#F0F0F0" />

    <!-- === Window Chrome === -->
    <Color x:Key="NexusChromeGradientStart">#ECECEC</Color>
    <Color x:Key="NexusChromeGradientMid1">#D8D8D8</Color>
    <Color x:Key="NexusChromeGradientMid2">#E8E8E8</Color>
    <Color x:Key="NexusChromeGradientMid3">#F0F0F0</Color>
    <Color x:Key="NexusChromeGradientEnd">#EAEAEA</Color>

    <!-- === Title Bar === -->
    <Color x:Key="NexusTitleBarGradientStart">#E8E8E8</Color>
    <Color x:Key="NexusTitleBarGradientEnd">#D4D4D4</Color>

    <!-- === Tab Bar === -->
    <SolidColorBrush x:Key="NexusTabBarBackground" Color="#E8E8E8" />
    <SolidColorBrush x:Key="NexusTabBarBorder" Color="#D4D4D4" />
    <SolidColorBrush x:Key="NexusTabActiveBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusTabActiveBorder" Color="#0078D4" />
    <SolidColorBrush x:Key="NexusTabInactiveBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NexusTabInactiveBorder" Color="#DCDCDC" />
    <SolidColorBrush x:Key="NexusTabCloseButton" Color="#909090" />

    <!-- === Toolbar === -->
    <Color x:Key="NexusToolbarGradientStart">#F6F6F6</Color>
    <Color x:Key="NexusToolbarGradientEnd">#E0E0E0</Color>
    <SolidColorBrush x:Key="NexusToolbarBorder" Color="#BFBFBF" />

    <!-- === Navigation Buttons === -->
    <Color x:Key="NexusNavBtnGradientStart">#FCFCFC</Color>
    <Color x:Key="NexusNavBtnGradientEnd">#E8E8E8</Color>
    <Color x:Key="NexusNavBtnHoverStart">#FFFFFF</Color>
    <Color x:Key="NexusNavBtnHoverEnd">#F0F0F0</Color>
    <Color x:Key="NexusNavBtnPressedStart">#D8D8D8</Color>
    <Color x:Key="NexusNavBtnPressedEnd">#C8C8C8</Color>
    <SolidColorBrush x:Key="NexusNavBtnBorder" Color="#B0B0B0" />
    <SolidColorBrush x:Key="NexusNavBtnForeground" Color="#3A3A3A" />

    <!-- === Segmented Buttons === -->
    <SolidColorBrush x:Key="NexusSegBtnBorder" Color="#B0B0B0" />
    <SolidColorBrush x:Key="NexusSegBtnForeground" Color="#4A4A4A" />
    <SolidColorBrush x:Key="NexusSegBtnHover" Color="#18000000" />
    <SolidColorBrush x:Key="NexusSegBtnPressed" Color="#28000000" />

    <!-- === Sidebar === -->
    <Color x:Key="NexusSidebarGradientStart">#E6EBF2</Color>
    <Color x:Key="NexusSidebarGradientEnd">#DFE5EE</Color>
    <SolidColorBrush x:Key="NexusSidebarBorder" Color="#C8C8C8" />
    <SolidColorBrush x:Key="NexusSidebarHeaderForeground" Color="#6E7B8B" />
    <SolidColorBrush x:Key="NexusSidebarItemForeground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="NexusSidebarItemHover" Color="#12000000" />
    <SolidColorBrush x:Key="NexusSidebarItemSelected" Color="#1A3B8DD4" />

    <!-- === Text === -->
    <SolidColorBrush x:Key="NexusText" Color="#2C2C2C" />
    <SolidColorBrush x:Key="NexusTextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="NexusTextSecondary" Color="#606060" />
    <SolidColorBrush x:Key="NexusTextTertiary" Color="#808080" />
    <SolidColorBrush x:Key="NexusTextDisabled" Color="#AAAAAA" />
    <SolidColorBrush x:Key="NexusTextPlaceholder" Color="#909090" />

    <!-- === Borders === -->
    <SolidColorBrush x:Key="NexusBorder" Color="#C8C8C8" />
    <SolidColorBrush x:Key="NexusBorderLight" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusBorderSubtle" Color="#D4D4D4" />

    <!-- === Accent / Selection === -->
    <SolidColorBrush x:Key="NexusAccent" Color="#3478F6" />
    <SolidColorBrush x:Key="NexusAccentHover" Color="#4A8AF7" />
    <SolidColorBrush x:Key="NexusAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusSelection" Color="#1A3B8DD4" />
    <SolidColorBrush x:Key="NexusSelectionHover" Color="#253B8DD4" />
    <SolidColorBrush x:Key="NexusSelectionFocused" Color="#303B8DD4" />
    <SolidColorBrush x:Key="NexusHover" Color="#0A000000" />
    <SolidColorBrush x:Key="NexusFocusBorder" Color="#5A9BDE" />

    <!-- === Status Colors === -->
    <SolidColorBrush x:Key="NexusDanger" Color="#D04040" />
    <SolidColorBrush x:Key="NexusDangerBackground" Color="#CC3333" />
    <SolidColorBrush x:Key="NexusSuccess" Color="#28C940" />
    <SolidColorBrush x:Key="NexusWarning" Color="#FFBD2E" />

    <!-- === Address Bar === -->
    <SolidColorBrush x:Key="NexusAddressBarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusAddressBarBorder" Color="#CCCCCC" />
    <SolidColorBrush x:Key="NexusAddressBarEditBorder" Color="#0078D4" />
    <SolidColorBrush x:Key="NexusBreadcrumbForeground" Color="#808080" />
    <SolidColorBrush x:Key="NexusBreadcrumbSeparator" Color="#888888" />
    <SolidColorBrush x:Key="NexusBreadcrumbIcon" Color="#606060" />
    <SolidColorBrush x:Key="NexusBreadcrumbActiveForeground" Color="#1A1A1A" />

    <!-- === Search Box === -->
    <SolidColorBrush x:Key="NexusSearchBackground" Color="#F8F8F8" />
    <SolidColorBrush x:Key="NexusSearchBorder" Color="#B8B8B8" />
    <SolidColorBrush x:Key="NexusSearchFocusBorder" Color="#5A9BDE" />
    <SolidColorBrush x:Key="NexusSearchFocusBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusSearchIcon" Color="#909090" />

    <!-- === File View === -->
    <SolidColorBrush x:Key="NexusFileViewBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusFileItemText" Color="#2A2A2A" />
    <SolidColorBrush x:Key="NexusFileItemSecondaryText" Color="#808080" />
    <SolidColorBrush x:Key="NexusFileItemInfoText" Color="#8A8A8A" />
    <SolidColorBrush x:Key="NexusGroupHeaderText" Color="#202020" />
    <SolidColorBrush x:Key="NexusGroupHeaderBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusDetailsHeaderBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NexusDetailsHeaderBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusDetailsHeaderForeground" Color="#404040" />

    <!-- === Preview Panel === -->
    <SolidColorBrush x:Key="NexusPreviewBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="NexusPreviewBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusPreviewImageBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NexusPreviewTextBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusPreviewTextBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusPreviewTextForeground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="NexusPreviewFileName" Color="#2A2A2A" />
    <SolidColorBrush x:Key="NexusPreviewMetadata" Color="#707070" />
    <SolidColorBrush x:Key="NexusPreviewPlaceholder" Color="#909090" />

    <!-- === Status Bar === -->
    <Color x:Key="NexusStatusBarGradientStart">#E8E8E8</Color>
    <Color x:Key="NexusStatusBarGradientEnd">#D0D0D0</Color>
    <SolidColorBrush x:Key="NexusStatusBarBorder" Color="#BFBFBF" />
    <SolidColorBrush x:Key="NexusStatusBarText" Color="#4A4A4A" />
    <SolidColorBrush x:Key="NexusStatusBarTextSecondary" Color="#5A5A5A" />
    <SolidColorBrush x:Key="NexusStatusBarIcon" Color="#6A6A6A" />

    <!-- === Dialogs === -->
    <SolidColorBrush x:Key="NexusDialogBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusDialogScrim" Color="#80000000" />
    <SolidColorBrush x:Key="NexusDialogText" Color="#404040" />
    <SolidColorBrush x:Key="NexusDialogLabel" Color="#505050" />

    <!-- === Progress === -->
    <SolidColorBrush x:Key="NexusProgressBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusProgressForeground" Color="#4A9FDE" />
    <SolidColorBrush x:Key="NexusProgressTrack" Color="#E0E0E0" />

    <!-- === Mac Button === -->
    <SolidColorBrush x:Key="NexusMacBtnForeground" Color="#4A4A4A" />
    <SolidColorBrush x:Key="NexusMacBtnHover" Color="#22000000" />
    <SolidColorBrush x:Key="NexusMacBtnPressed" Color="#33000000" />

    <!-- === Splitter === -->
    <SolidColorBrush x:Key="NexusSplitDivider" Color="#D0D0D0" />

    <!-- === Terminal Container === -->
    <SolidColorBrush x:Key="NexusTerminalBorder" Color="#333333" />

    <!-- === TextBox / Input === -->
    <SolidColorBrush x:Key="NexusInputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NexusInputBorder" Color="#C0C0C0" />
    <SolidColorBrush x:Key="NexusInputFocusBorder" Color="#5A9BDE" />
    <SolidColorBrush x:Key="NexusInputHoverBorder" Color="#9ABFDF" />

    <!-- === Rubber Band (Selection Rectangle) === -->
    <SolidColorBrush x:Key="NexusRubberBandFill" Color="#220078D7" />
    <SolidColorBrush x:Key="NexusRubberBandStroke" Color="#990078D7" />

    <!-- === Drive Usage === -->
    <SolidColorBrush x:Key="NexusDriveUsageForeground" Color="#4A9FDE" />
    <SolidColorBrush x:Key="NexusDriveUsageBackground" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusDriveUsageText" Color="#808080" />

    <!-- === Layout mode border === -->
    <SolidColorBrush x:Key="NexusLayoutModeBorder" Color="#B0B0B0" />

    <!-- === New keys (modern redesign) === -->
    <SolidColorBrush x:Key="NexusNavGroupBackground" Color="#F4F4F4" />
    <SolidColorBrush x:Key="NexusNavGroupBorder" Color="#D8D8D8" />
    <SolidColorBrush x:Key="NexusTabNewBtnBackground" Color="#F0F0F0" />
    <SolidColorBrush x:Key="NexusTabNewBtnBorder" Color="#D4D4D4" />
    <SolidColorBrush x:Key="NexusTabNewBtnForeground" Color="#808080" />
    <SolidColorBrush x:Key="NexusSidebarItemSelectedBorder" Color="#0078D4" />
    <SolidColorBrush x:Key="NexusAccentSubtle" Color="#E8F4FD" />
    <SolidColorBrush x:Key="NexusFileItemExtensionText" Color="#A0A0A0" />
    <SolidColorBrush x:Key="NexusSliderTrack" Color="#E0E0E0" />
    <SolidColorBrush x:Key="NexusSliderThumb" Color="#606060" />

</ResourceDictionary>
